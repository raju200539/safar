{
  "name": "hyd-transit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:api": "pnpm --filter @hyd/api dev",
    "dev:mobile": "pnpm --filter @hyd/mobile dev",
