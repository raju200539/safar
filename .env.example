# Copy to .env and fill in. Never commit .env.
PORT=3000
OTP_URL=http://localhost:8080
DATABASE_URL=postgres://hyd:hyd@localhost:5432/hydtransit
LIVE_ENABLED=false
GEOCODER_URL=https://nominatim.openstreetmap.org
# LAN IP of this machine for Expo Go (e.g. http://192.168.1.5:3000).
# NOTE: the phone app reads its address from apps/mobile/.env (Expo only
# loads .env files inside apps/mobile). Keep both in sync.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
